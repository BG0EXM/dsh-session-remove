{
  "name": "dsh-session-remove",
  "version": "1.0.5",
  "description": "Stop or permanently delete DeepSeek Harness sessions from the sidebar session menu: cancels running turns, subagents, background jobs and reminders, then removes the log, subagent session logs, projection cache and workspace record, with an optional cleanup of session-produced workspace files and orphaned attachments.",
  "type": "module",
  "license": "MIT",
  "author": "bg0exm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BG0EXM/dsh-session-remove.git"
  },
  "homepage": "https://github.com/BG0EXM/dsh-session-remove#readme",
  "bugs": {
    "url": "https://github.com/BG0EXM/dsh-session-remove/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "session",
    "delete"
  ],
  "engines": {
    "node": ">=22"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "README.md",
    "LICENSE",
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0"
  }
}
